# ------------------------------------------------------------------------------
# Ghostty Config! 👻
# ------------------------------------------------------------------------------

# Theme (see ghostty/themes)
theme = miami-nights

# Font Family
font-family = JetBrains Mono
font-family = Symbols Nerd Font Mono

# Font Size
font-size = 16

# Window Config
macos-titlebar-style = hidden
window-width = 140
window-height = 30
window-padding-y = 16,12
window-padding-x = 16

# Line height
adjust-cell-height = 65%
adjust-cursor-height = 65%
adjust-underline-position = 15%
adjust-font-baseline = 9%

# Cursor style
cursor-style = block
cursor-style-blink = false

# Clipboard settings
clipboard-read = allow
clipboard-write = allow

# Allow option to work as alt on macos
macos-option-as-alt = true

# Ensure shift+enter always works as soft line break
keybind = shift+enter=text:\x1b[13;2u

# Open or create tmux session
keybind = cmd+k=text:\x02s

# Open or create tmux session at root
keybind = cmd+r=text:\x02r
keybind = cmd+shift+k=text:\x02r
# TODO: Why won't cmd+shift+k work? 🤔
